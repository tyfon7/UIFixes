<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Shared.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Tyfon.UIFixes</AssemblyName>
    <Description>SPT UI Fixes</Description>
    <SPTModType>Client</SPTModType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release</Configurations>
    <!-- Switching to allow-listing for 5.0 iterative work-->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);UIFixes.Test\**;UIFixes.Net\**;UIFixes.Server\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\Plugin.cs" />
    <Compile Include="src\ConfigurationManagerAttributes.cs" />
    <Compile Include="src\Il2CppExtensions.cs" />
    <Compile Include="src\Settings\Settings.cs" />
    <Compile Include="src\Settings\SettingExtensions.cs" />
    <Compile Include="src\Settings\SettingSections.cs" />
    <Compile Include="src\Settings\SettingTypes.cs" />
    <Compile Include="src\Patches\AddOfferClickablePricesPatches.cs" />
    <Compile Include="src\Patches\AFKPatches.cs" />
    <Compile Include="src\Patches\ConfirmationPatches.cs" />
    <Compile Include="src\Patches\ConfirmDialogKeysPatches.cs" />
    <Compile Include="src\Patches\CursorPatches.cs" />
    <Compile Include="src\Patches\InspectWindowStatsPatches.cs" />
    <Compile Include="src\Patches\FocusFleaOfferNumberPatches.cs" />
    <Compile Include="src\Patches\ScrollPatches.cs" />
    <Compile Include="src\Patches\SwapPatches.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTushonka.Common" />
    <Reference Include="SPTushonka.Reflection" />

    <Reference Include="BepInEx.Core" />
    <Reference Include="BepInEx.Unity.IL2CPP" />

    <Reference Include="0Harmony" />
    <Reference Include="AnimationSystem.Types" />
    <Reference Include="Assembly-CSharp" />
    <Reference Include="Comfort" />
    <Reference Include="Comfort.Unity" />
    <Reference Include="CommonExtensions" />
    <Reference Include="ConfigurationManager" />
    <Reference Include="Diz.Binding" />
    <!-- <Reference Include="Fika.Core" /> -->
    <Reference Include="ItemComponent.Types" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="Sirenix.Serialization" />
    <Reference Include="Unity.TextMeshPro" />
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.AnimationModule" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.IMGUIModule" />
    <Reference Include="UnityEngine.InputLegacyModule" />
    <Reference Include="UnityEngine.TextRenderingModule" />
    <Reference Include="UnityEngine.UI" />
    <Reference Include="UnityEngine.UIModule" />

    <Reference Include="Il2Cppmscorlib" />
    <Reference Include="Il2CppInterop.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2"
      PrivateAssets="all" />
  </ItemGroup>

  <!-- <ItemGroup>
    <ProjectReference Include="UIFixes.Net\UIFixes.Net.csproj" />
  </ItemGroup> -->

  <Target Name="PostBuildRelease" AfterTargets="PostBuildEvent"
    Condition="'$(Configuration)'=='Release'">
    <Exec
      Command='7z a -tzip dist\$(TargetName.Replace(".", "-"))-$(Version).zip $(SolutionDir)dist\BepInEx $(SolutionDir)dist\SPT_Runtime' />
  </Target>

</Project>